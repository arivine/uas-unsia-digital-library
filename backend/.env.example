# Server
PORT=5000
NODE_ENV=development

# MongoDB (local / docker)
MONGO_URI=mongodb://127.0.0.1:27017/unsia-library

# JWT
JWT_SECRET=ubah_ini_dengan_secret_acak_yang_panjang
JWT_EXPIRES_IN=1d

# CORS (comma separated origins, * untuk semua)
CLIENT_URL=http://localhost:5173

# Auto-seed data contoh saat database kosong (true/false)
AUTO_SEED=true
